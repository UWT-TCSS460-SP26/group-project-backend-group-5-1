generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  subjectId String   @unique
  username  String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings Rating[]
  reviews Review[]
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  mediaType String
  mediaId   Int
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review?

  @@unique([userId, mediaId])
  @@index([mediaId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  ratingId  Int      @unique
  mediaType String
  mediaId   Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([mediaId])
}

enum IssueStatus {
  Open
  InProgress
  Resolved
  Closed
}

model Issue {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  reproSteps  String?
  reporter    String?
  status      IssueStatus @default(Open)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
